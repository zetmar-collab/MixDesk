{
  "name": "mixdesk",
  "version": "1.0.0",
  "description": "Independent Mixcloud desktop player for Windows",
  "main": "electron/main.cjs",
  "author": "MixDesk contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "build": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir --win --x64",
    "test:live": "node tests/live.cjs",
    "build:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "pl.mixdesk.player",
    "productName": "MixDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/mixdesk.ico"
    },
    "portable": {
      "artifactName": "MixDesk.exe"
    },
    "extraResources": [
      {
        "from": "vendor/yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "vendor",
        "to": "licenses",
        "filter": [
          "*.txt",
          "SHA256SUMS"
        ]
      }
    ]
  }
}
